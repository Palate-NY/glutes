{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Palate-NY/glutes/schema/plan.schema.json",
  "title": "Glutes training plan",
  "description": "One file per plan in src/data/plans/. Days reference session ids from src/data/sessions/*.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "start", "blocks", "weeks"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "Stable id, also stored in the browser as the selected plan." },
    "name": { "type": "string", "minLength": 1, "description": "Shown in the plan selector." },
    "status": { "enum": ["active", "completed", "draft"], "description": "completed plans get a check mark in the selector. Default active." },
    "start": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Monday of week 1, YYYY-MM-DD. Every date in the app derives from this." },
    "goal": { "type": "string", "description": "Shown above the Upcoming list." },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "description": "Phases. Week ranges and dates are computed from the weeks that reference each block.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "focus", "purpose"],
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string", "minLength": 1 },
          "focus": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 }
        }
      }
    },
    "weeks": {
      "type": "array",
      "minItems": 1,
      "description": "Ordered. week numbers must run 1..n with no gaps.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["week", "label", "block", "days"],
        "properties": {
          "week": { "type": "integer", "minimum": 1 },
          "label": { "type": "string", "minLength": 1, "description": "First word is dropped in the week title, e.g. 'SEP W1 Prep' shows as 'W1 Prep'." },
          "block": { "type": "integer", "description": "A block id from blocks[]." },
          "days": {
            "type": "array",
            "minItems": 7,
            "maxItems": 7,
            "description": "Mon..Sun. A session id, or a list of ids for a double day (first one is the main ride).",
            "items": {
              "oneOf": [
                { "type": "string", "pattern": "^[A-Za-z0-9_]+$" },
                { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[A-Za-z0-9_]+$" } }
              ]
            }
          }
        }
      }
    },
    "upcoming": {
      "type": "array",
      "description": "Phases not yet planned in detail. Listed above Upcoming, nothing else.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "focus", "when"],
        "properties": {
          "name": { "type": "string" },
          "focus": { "type": "string" },
          "when": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    }
  }
}

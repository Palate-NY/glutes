{
  "id": "2027-season",
  "name": "2027 Season",
  "status": "active",
  "start": "2026-09-07",
  "goal": "FTP 300W + 700W/50s sprint by August 2027. Full-season plan, 50 weeks, 7-8 hrs/week with two peaks: VO2 block in spring, sprint block before Cannes.",
  "blocks": [
    { "id": 1, "name": "Phase 1", "focus": "Prep",
      "purpose": "Restart after the summer break (Sep 7-27). Easy aerobic riding, reintroduce strength, first neural sprints. Long ride moves to Friday for the whole season." },
    { "id": 2, "name": "Phase 2", "focus": "Foundation",
      "purpose": "Aerobic base, flat and boring on purpose (Sep 28 - Dec 27). 7-8 hrs/week ride, never more: the big weeks belong in spring. Heavy strength 2x/week (squat, hip thrust, split squat), neural sprints weekly, Friday long ride grows 2h to 3h. Sweet spot enters in December, then Half Monty on Dec 23." },
    { "id": 3, "name": "Phase 3", "focus": "Build",
      "purpose": "Threshold (Dec 28 - Mar 21). Pyramidal week: one threshold day (SS, THR, over-unders, low-cadence climb sims) plus sweet spot inside every other long ride. Heavy strength 2x/week until W24, then 1x. Recovery every 4th week. Half Monty + first 50s sprint test on W28." },
    { "id": 4, "name": "Phase 4", "focus": "VO2max",
      "purpose": "Polarized 8 weeks (Mar 22 - May 16): two VO2 days (Tue + Sun), everything else easy. Strength drops to maintenance 1x/week. This is where FTP 300 gets made. 5min power test on W36." },
    { "id": 5, "name": "Phase 5", "focus": "Specific",
      "purpose": "Sprint + anaerobic capacity (May 17 - Jun 27) with threshold maintenance. Wed 50s sprint reps, Sun 6x1min, power-focused gym on Mon. Sprint test on W40. Last week tapers into the camp." },
    { "id": 6, "name": "Cannes", "focus": "Camp",
      "purpose": "Heat-adapted camp week (Jun 28 - Jul 4). Big volume, low intensity except the two Tanneron days. Fuel, sleep, no heroics on Vence." },
    { "id": 7, "name": "Phase 7", "focus": "Peak",
      "purpose": "Recover from camp, three sharpening weeks, then a two-week taper: volume down 40-50%, intensity kept. Test week Aug 9-15: Half Monty Wed, 50s sprint Sat. W50 is the backup and the PR day. If testing at altitude in Ardèche, expect FTP to read low; trust the sprint number." }
  ],

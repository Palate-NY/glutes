{
  "id": "2027-season",
  "name": "2027 Season",
  "status": "active",
  "start": "2026-09-07",
  "goal": "FTP 300W + 700W/50s sprint by August 2027. 7 weeks of free riding (Sep 14 - Nov 1), then 42 structured weeks at 7-8 hrs/week: Foundation, Build, VO2 block, Sprint block, Cannes camp, Peak. Test week Aug 9-15 2027.",
  "blocks": [
    { "id": 1, "name": "Phase 0", "focus": "Prep",
      "purpose": "One week of easy riding after the summer (Sep 7-13)." },
    { "id": 2, "name": "Transition", "focus": "Free",
      "purpose": "Sep 14 - Nov 1: seven weeks of riding for fun. No targets, no plan, log nothing. Gym comes back mid-October (bodyweight one week, then heavy 2x/week) because strength is the slowest thing to rebuild and it carries the 700W." },
    { "id": 3, "name": "Phase 1", "focus": "Foundation",
      "purpose": "Aerobic base, flat and boring on purpose (Nov 2 - Jan 24). 7-8 hrs/week ride, never more. Heavy strength 2x/week, neural sprints weekly, Friday long ride 2h to 3h. Sweet spot from December, threshold in January, Half Monty on Jan 20." },
    { "id": 4, "name": "Phase 2", "focus": "Build",
      "purpose": "Threshold (Jan 25 - Mar 21). Pyramidal week: one threshold day (THR, over-unders, low-cadence climb sims) plus sweet spot inside most long rides. Heavy strength 2x/week until W24, then 1x. Half Monty + first 50s sprint test on W28." },
    { "id": 5, "name": "Phase 3", "focus": "VO2max",
      "purpose": "Polarized 8 weeks (Mar 22 - May 16): two VO2 days (Tue + Sun), everything else easy. Strength to maintenance 1x/week. This is where FTP 300 gets made. 5min test on W36." },
    { "id": 6, "name": "Phase 4", "focus": "Specific",
      "purpose": "Sprint + anaerobic capacity (May 17 - Jun 27) with threshold maintenance. Wed 50s sprint reps, Sun 6x1min, power gym Mon. Sprint test on W40. Last week tapers into the camp." },
    { "id": 7, "name": "Cannes", "focus": "Camp",
      "purpose": "Heat-adapted camp week (Jun 28 - Jul 4). Big volume, low intensity except the two Tanneron days. Fuel, sleep, no heroics on Vence." },
    { "id": 8, "name": "Phase 5", "focus": "Peak",
      "purpose": "Recover from camp, three sharpening weeks, then a two-week taper: volume down 40-50%, intensity kept. Test week Aug 9-15: Half Monty Wed, 50s sprint Sat. W50 is the backup and the PR day. At altitude in Ardèche, expect FTP to read low; trust the sprint number." }
  ],
